{
  "name": "metodo-paraguay",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Página de vendas — Método Paraguay",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve:static": "node scripts/serve.mjs",
    "gen:placeholders": "node scripts/gen-placeholders.mjs",
    "verify:assets": "node scripts/verify-assets.mjs",
    "produto:pdf": "node scripts/produto/build-pdfs.mjs",
    "produto:forms": "node scripts/produto/build-forms.mjs",
    "produto:xlsx": "node scripts/produto/build-xlsx.mjs",
    "produto:docx": "node scripts/produto/build-docx.mjs",
    "produto:plataforma": "node scripts/produto/build-plataforma.mjs",
    "produto:testar": "node scripts/produto/tools/test-plataforma.mjs",
    "produto:distribuir": "node scripts/produto/build-distribuicao.mjs",
    "produto:build": "npm run produto:xlsx && npm run produto:docx && npm run produto:pdf && npm run produto:forms && npm run produto:plataforma && npm run produto:testar && npm run produto:distribuir"
  },
  "dependencies": {
    "framer-motion": "^11.3.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "embla-carousel-react": "^8.1.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
